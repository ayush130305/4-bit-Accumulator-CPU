# pnr_core.tcl - SCL C1D core-block place & route (floorplan -> pdn -> place -> cts -> route)
# Based on SCL's scripts_template/*.tcl, merged into one parameterized run.
# Run inside the OpenLane container (see flow/run_pnr.sh). Inputs via environment:
#   C1D NETLIST DESIGN OUT PINS_TCL DIE_W DIE_H CORE_M VDD_Y VSS_Y CLK_PERIOD PL_DENSITY

set C1D   $::env(C1D)
set OUT   $::env(OUT)
file mkdir $OUT

# ---- Libraries ------------------------------------------------------------------------------
read_liberty $C1D/lib/c1d_core_$::env(PNR_CORNER).lib   ;# worst-slew corner for sizing
read_lef $C1D/lef/tech_c1d.lef
read_lef $::env(CORE_LEF)
read_verilog $::env(NETLIST)
link_design $::env(DESIGN)

# ---- Floorplan (SCL: remove alternating rows) ------------------------------------------------
set W $::env(DIE_W); set H $::env(DIE_H); set M $::env(CORE_M)
initialize_floorplan -site CORE -die_area "0 0 $W $H" -core_area "$M $M [expr $W-$M] [expr $H-$M]"
set count 0
foreach row [[ord::get_db_block] getRows] {
    if { [expr $count % 2] != 0 } { odb::dbRow_destroy $row }
    incr count
}
puts "FLOW: rows kept = [llength [[ord::get_db_block] getRows]]"
make_tracks metal1 -x_offset 0.0 -x_pitch 4.0 -y_offset 0.0 -y_pitch 4.0
make_tracks metal2 -x_offset 0.0 -x_pitch 4.2 -y_offset 0.0 -y_pitch 4.2

# ---- Pins facing their frame pads (generated by flow/gen_pins.py) ---------------------------
source $::env(PINS_TCL)

# ---- Power: ring + followpins + one M1 stripe per net to the W/E die edges ------------------
add_global_connection -net VDD -pin_pattern VDD -power
add_global_connection -net VSS -pin_pattern VSS -ground
global_connect
set_voltage_domain -name CORE -power VDD -ground VSS
define_pdn_grid -name Core -voltage_domain CORE
add_pdn_ring -grid Core -layers {metal1 metal2} -widths {12 12} -spacings {6 6} -core_offsets {20 20}
add_pdn_stripe -grid Core -layer metal1 -width 9.0 -followpins -extend_to_core_ring
add_pdn_connect -grid Core -layers {metal1 metal2}
pdngen

# Edge stripes: pdngen drops -nets stripes here, so add them with OpenDB. Each is a 20 um M1 wire
# at a row-gap centre from die edge to die edge, with VIA12 arrays where it crosses its own ring leg.
proc add_edge_stripe {netname yc} {
    set block [ord::get_db_block]
    set tech  [[ord::get_db] getTech]
    set dbu   [$block getDbUnitsPerMicron]
    set m1    [$tech findLayer metal1]
    set via   [$tech findVia VIA12]
    set net   [$block findNet $netname]
    set die   [$block getDieArea]
    set y1 [expr round(($yc - 10.0) * $dbu)]; set y2 [expr round(($yc + 10.0) * $dbu)]
    set sw [odb::dbSWire_create $net ROUTED]
    odb::dbSBox_create $sw $m1 [$die xMin] $y1 [$die xMax] $y2 STRIPE
    set nvia 0
    foreach w [$net getSWires] {
        foreach b [$w getWires] {
            if {[$b isVia]} continue
            if {[$b getWireShapeType] != "RING" || [[$b getTechLayer] getName] != "metal2"} continue
            if {[$b yMin] > $y1 || [$b yMax] < $y2} continue
            for {set x [expr [$b xMin] + 2500]} {$x <= [$b xMax] - 2500} {incr x 3000} {
                for {set y [expr $y1 + 2500]} {$y <= $y2 - 2500} {incr y 3000} {
                    odb::dbSBox_create $sw $via $x $y STRIPE; incr nvia
                }
            }
        }
    }
    puts "FLOW: edge stripe $netname at y=$yc, $nvia vias"
}
add_edge_stripe VDD $::env(VDD_Y)
add_edge_stripe VSS $::env(VSS_Y)
write_def $OUT/1_pdn.def

# ---- Placement --------------------------------------------------------------------------------
global_placement -density $::env(PL_DENSITY)

# Fix max-slew / max-cap with the resizer (not in SCL's template; 1.2 um cells + long wires
# otherwise give ~7 ns slews against the 2.5 ns liberty limit). DELBUF is a delay cell, not a driver.
set_wire_rc -signal -layer metal2
set_wire_rc -clock  -layer metal2
set_dont_use {DELBUF FILLER1 FILLER2 FILLER3 FILLER4 FILLER5 NND201}
estimate_parasitics -placement
repair_design   ;# plain call only: any margin / fanout limit / slow lib makes this OpenROAD build run away
detailed_placement -max_displacement {500 200}
check_placement -verbose
write_def $OUT/2_place.def

# ---- Clock tree (CDRI01 clock drivers) --------------------------------------------------------
set_cmd_units -time ns -capacitance pF -resistance kOhm -voltage V -current mA
create_clock -name CLK -period $::env(CLK_PERIOD) [get_ports clk]
set_propagated_clock [all_clocks]
clock_tree_synthesis -root_buf CDRI01 -buf_list "CDRI01" -sink_clustering_enable   ;# SCL template used INVR01
repair_clock_nets
detailed_placement -max_displacement {500 200}

# Abut cells closer than MIN_GAP (left shifts only, so no overlaps). SCL's fillers only bridge
# boron in part of the row height, so any 0 < gap < 1.5 um leaves boron notches (rule 5.7.1) and
# FILLER5 boron intrudes on neighbour ndiff (5.4.1/5.5.1). No fillers are used.
proc abut_rows {min_gap_um} {
    set block [ord::get_db_block]
    set dbu [$block getDbUnitsPerMicron]
    set min_gap [expr round($min_gap_um * $dbu)]
    set moved 0
    foreach row [$block getRows] {
        set ry [[$row getBBox] yMin]
        set cells {}
        foreach inst [$block getInsts] {
            if {[[$inst getMaster] getType] != "CORE"} continue
            set loc [$inst getLocation]
            if {[lindex $loc 1] == $ry} { lappend cells [list [lindex $loc 0] $inst] }
        }
        set prev_end ""
        foreach pair [lsort -integer -index 0 $cells] {
            lassign $pair x inst
            set w [[$inst getMaster] getWidth]
            if {$prev_end ne "" && $x != $prev_end && [expr $x - $prev_end] < $min_gap} {
                $inst setLocation $prev_end $ry
                set x $prev_end
                incr moved
            }
            set prev_end [expr $x + $w]
        }
    }
    puts "FLOW: abut_rows moved $moved cells (min gap $min_gap_um um)"
}
abut_rows $::env(MIN_GAP)
check_placement -verbose
write_def $OUT/3_cts.def

# ---- via1 blockages from earlier DRC iterations (flow/drc_fix_loop.sh): "x1 y1 x2 y2" per line --
set nblk 0
set via1 [[[ord::get_db] getTech] findLayer via1]
set dbu [[ord::get_db_block] getDbUnitsPerMicron]
if {[file exists $::env(BLOCKAGES)]} {
    set fh [open $::env(BLOCKAGES)]
    while {[gets $fh line] >= 0} {
        if {[llength $line] != 4} continue
        lassign $line x1 y1 x2 y2
        odb::dbObstruction_create [ord::get_db_block] $via1 [expr round($x1*$dbu)] [expr round($y1*$dbu)] [expr round($x2*$dbu)] [expr round($y2*$dbu)]
        incr nblk
    }
    close $fh
}
puts "FLOW: via1 blockages = $nblk"

# ---- Routing (2 metals) -----------------------------------------------------------------------
set_global_routing_layer_adjustment metal1 0
set_global_routing_layer_adjustment metal2 0
set_routing_layers -signal metal1-metal2 -clock metal1-metal2
global_route -allow_congestion -verbose
detailed_route -top_routing_layer metal2 -via_in_pin_bottom_layer metal1 -via_in_pin_top_layer metal2 \
    -output_drc $OUT/4_route_drc.rpt -verbose 1
write_def $OUT/4_route.def
write_db  $OUT/4_route.odb
write_verilog -include_pwr_gnd $OUT/$::env(DESIGN)_pwr.v
write_verilog $OUT/$::env(DESIGN)_rt.v
puts "FLOW: done"
exit
